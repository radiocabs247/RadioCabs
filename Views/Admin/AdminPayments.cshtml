@model List<Radiocab.Models.Payment>

@{
    ViewData["Title"] = "Payment Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="card shadow border-0">

        <!-- HEADER -->
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Payment Management</h4>

            <a asp-action="Index" asp-controller="Admin" class="btn btn-outline-light btn-sm">
                Dashboard
            </a>
        </div>

        <div class="card-body">

            <!-- TABLE -->
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Receipt</th>
                                <th>Transaction</th>
                                <th>Entity</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.PaymentId</td>
                                    <td>@item.ReceiptNumber</td>
                                    <td>@item.TransactionId</td>
                                    <td>@item.EntityType (@item.EntityId)</td>
                                    <td>@item.Amount</td>
                                    <td>@item.PaymentMethod</td>
                                    <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>

                                    <td>
                                        @if (item.Status == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@item.Status</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="PaymentDetails"
                                               asp-route-id="@item.PaymentId"
                                               class="btn btn-sm btn-primary">
                                            View
                                        </a>

                                        <a asp-action="DeletePayment"
                                               asp-route-id="@item.PaymentId"
                                               class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    No payments found
                </div>
            }

        </div>
    </div>
</div>