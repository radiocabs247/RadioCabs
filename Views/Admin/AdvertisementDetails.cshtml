@model Radiocab.Models.Advertise
@{
    ViewData["Title"] = "Advertisement Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Advertisement Details</h5>
        <dl class="row">
            <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Designation</dt><dd class="col-sm-9">@Model.Designation</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Mobile</dt><dd class="col-sm-9">@Model.Mobile</dd>
            <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address</dd>
            <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Payment</dt><dd class="col-sm-9">@Model.PaymentType - $@Model.PaymentAmount (@Model.PaymentStatus)</dd>
        </dl>
        <a asp-action="Advertisements" class="btn btn-secondary btn-sm">Back</a>
    </div>
</div>
