@model List<Radiocab.Models.Feedback>
@{
    ViewData["Title"] = "Feedbacks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">User Feedbacks</h5>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.City</td>
                            <td>@item.Type</td>
                            <td class="text-end">
                                <a asp-action="FeedbackDetails" asp-route-id="@item.FeedbackId" class="btn btn-outline-secondary btn-sm">Details</a>
                                <a asp-action="EditFeedback" asp-route-id="@item.FeedbackId" class="btn btn-outline-primary btn-sm">Edit</a>
                                <a asp-action="DeleteFeedback" asp-route-id="@item.FeedbackId" class="btn btn-outline-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
