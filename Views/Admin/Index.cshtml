@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var logs = ViewBag.RecentLogs as List<Radiocab.Models.ActivityLog> ?? new List<Radiocab.Models.ActivityLog>();
}

<div class="container-fluid py-2">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center bg-dark text-white p-4 rounded-4 shadow-sm">
                <div>
                    <h2 class="mb-1 text-warning"><i class="fas fa-chart-pie me-2"></i>Administration Panel</h2>
                    <p class="text-light text-opacity-75 mb-0 small">Real-time statistics, registrations overview, directory moderation, and transaction logs.</p>
                </div>
                <div class="text-end d-none d-sm-block">
                    <span class="badge bg-warning text-dark px-3 py-2 fw-semibold"><i class="fas fa-calendar-alt me-1"></i>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 6 Dashboard Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-2 col-md-4">
            <div class="stat-card p-3 h-100 text-center border-top border-4 border-primary shadow-2xs">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                    <i class="fas fa-building text-primary fs-5"></i>
                </div>
                <h6 class="text-muted small mb-1">Total Companies</h6>
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.TotalCompanies</h4>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="stat-card p-3 h-100 text-center border-top border-4 border-success shadow-2xs">
                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                    <i class="fas fa-id-card text-success fs-5"></i>
                </div>
                <h6 class="text-muted small mb-1">Total Drivers</h6>
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.TotalDrivers</h4>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="stat-card p-3 h-100 text-center border-top border-4 border-warning shadow-2xs">
                <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                    <i class="fas fa-bullhorn text-warning fs-5"></i>
                </div>
                <h6 class="text-muted small mb-1">Advertisements</h6>
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.TotalAdvertisements</h4>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="stat-card p-3 h-100 text-center border-top border-4 border-info shadow-2xs">
                <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                    <i class="fas fa-comments text-info fs-5"></i>
                </div>
                <h6 class="text-muted small mb-1">Total Feedbacks</h6>
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.TotalFeedbacks</h4>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="stat-card p-3 h-100 text-center border-top border-4 border-danger shadow-2xs">
                <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                    <i class="fas fa-user-check text-danger fs-5"></i>
                </div>
                <h6 class="text-muted small mb-1">Paid Users</h6>
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.TotalPaidUsers</h4>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="stat-card p-3 h-100 text-center border-top border-4 border-secondary shadow-2xs">
                <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                    <i class="fas fa-credit-card text-secondary fs-5"></i>
                </div>
                <h6 class="text-muted small mb-1">Pending Invoices</h6>
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.TotalPendingPayments</h4>
            </div>
        </div>
    </div>

    <!-- Main Visual Panels: Chart widgets & approvals -->
    <div class="row g-4 mb-4">
        <!-- Chart.js Revenue & Membership Distribution -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-chart-line me-2 text-warning"></i>Financials & Platform Health</h5>
                    <span class="badge bg-success">Total Cashflow: $@ViewBag.TotalRevenue</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-7 border-end">
                            <h6 class="fw-bold mb-3 text-secondary text-uppercase small">Revenue Overview</h6>
                            <div style="height: 220px; position: relative;">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <h6 class="fw-bold mb-3 text-secondary text-uppercase small text-center">Membership Distribution</h6>
                            <div style="height: 200px; position: relative;">
                                <canvas id="membershipChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Logs Feed -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-stream me-2 text-warning"></i>Recent Logs</h5>
                </div>
                <div class="card-body p-3">
                    @if (logs.Any())
                    {
                        <div class="vstack gap-2">
                            @foreach (var log in logs)
                            {
                                <div class="bg-light p-2 rounded-3 small border-start border-3 border-warning">
                                    <div class="d-flex justify-content-between mb-1">
                                        <strong class="text-dark">@log.Action</strong>
                                        <small class="text-muted" style="font-size: 0.7rem;">@log.CreatedAt.ToString("HH:mm")</small>
                                    </div>
                                    <span class="text-secondary d-block" style="font-size: 0.75rem;">@log.Description</span>
                                    <span class="text-muted d-block text-end" style="font-size: 0.65rem;">User: @log.UserId</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state py-4">
                            <i class="fas fa-info-circle text-muted fs-4 mb-2"></i>
                            <p class="mb-0 text-muted small">No activity logs recorded yet in current cycle.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Moderation Quick Actions Panels -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-building text-warning me-2"></i>Listings Approvals</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-warning bg-opacity-10 rounded-3">
                                <h3 class="text-warning fw-bold mb-0">@ViewBag.PendingCompanies</h3>
                                <small class="text-muted fw-semibold">Pending</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-success bg-opacity-10 rounded-3">
                                <h3 class="text-success fw-bold mb-0">@ViewBag.ApprovedCompanies</h3>
                                <small class="text-muted fw-semibold">Approved</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-danger bg-opacity-10 rounded-3">
                                <h3 class="text-danger fw-bold mb-0">@ViewBag.RejectedCompanies</h3>
                                <small class="text-muted fw-semibold">Rejected</small>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Listings" class="btn btn-outline-dark btn-sm w-100 fw-semibold"><i class="fas fa-cog me-1"></i>Moderation Listing Table</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-id-card text-warning me-2"></i>Drivers Approvals</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-warning bg-opacity-10 rounded-3">
                                <h3 class="text-warning fw-bold mb-0">@ViewBag.PendingDrivers</h3>
                                <small class="text-muted fw-semibold">Pending</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-success bg-opacity-10 rounded-3">
                                <h3 class="text-success fw-bold mb-0">@ViewBag.ApprovedDrivers</h3>
                                <small class="text-muted fw-semibold">Approved</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-danger bg-opacity-10 rounded-3">
                                <h3 class="text-danger fw-bold mb-0">@ViewBag.RejectedDrivers</h3>
                                <small class="text-muted fw-semibold">Rejected</small>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Drivers" class="btn btn-outline-dark btn-sm w-100 fw-semibold"><i class="fas fa-cog me-1"></i>Moderation Driver Table</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<!-- Import Chart.js from CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Revenue Overview Area Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        
        // Mocking billing increments ending in current total revenue
        const totalRev = parseFloat("@ViewBag.TotalRevenue") || 0;
        const incrementalRev = totalRev > 0 
            ? [totalRev * 0.1, totalRev * 0.25, totalRev * 0.45, totalRev * 0.6, totalRev * 0.8, totalRev]
            : [0, 0, 0, 0, 0, 0];

        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Paid Revenue ($)',
                    data: incrementalRev,
                    borderColor: '#276EF1',
                    backgroundColor: 'rgba(39, 110, 241, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointBackgroundColor: '#FFD000',
                    pointBorderColor: '#fff',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0, 0, 0, 0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Membership Distribution Doughnut Chart
        const membershipCtx = document.getElementById('membershipChart').getContext('2d');
        const freeCount = parseInt("@ViewBag.FreeCompanies") || 0;
        const basicCount = parseInt("@ViewBag.BasicCompanies") || 0;
        const premiumCount = parseInt("@ViewBag.PremiumCompanies") || 0;

        new Chart(membershipCtx, {
            type: 'doughnut',
            data: {
                labels: ['Free Plan', 'Basic Plan', 'Premium Plan'],
                datasets: [{
                    data: [
                        freeCount === 0 && basicCount === 0 && premiumCount === 0 ? 1 : freeCount,
                        basicCount, 
                        premiumCount
                    ],
                    backgroundColor: ['#6b7280', '#276EF1', '#FFD000'],
                    borderWidth: 2,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 12 }
                    }
                },
                cutout: '65%'
            }
        });
    });
</script>
}
