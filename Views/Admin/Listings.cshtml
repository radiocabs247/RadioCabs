@model List<Radiocab.Models.Listing>
@{
    ViewData["Title"] = "Listings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">All Listings</h5>
            <a asp-action="AddCompany" class="btn btn-primary btn-sm">Add Listing</a>
        </div>
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Search company or city" value="@ViewBag.Search" />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option selected="@(ViewBag.Status=="All")">All</option>
                    <option selected="@(ViewBag.Status=="Pending")">Pending</option>
                    <option selected="@(ViewBag.Status=="Approved")">Approved</option>
                    <option selected="@(ViewBag.Status=="Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2"><button class="btn btn-warning w-100">Filter</button></div>
        </form>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Company ID</th>
                        <th>City</th>
                        <th>Payment</th>
                        <th>Approval</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.CompanyCode</td>
                                <td>@item.City</td>
                                <td>@item.PaymentType ($@item.PaymentAmount)</td>
                                <td><span class="badge @(item.Status=="Approved"?"bg-success":item.Status=="Rejected"?"bg-danger":"bg-warning text-dark")">@item.Status</span></td>
                                <td class="text-end">
                                    @if (item.Status != "Approved")
                                    {
                                        <button type="button" class="btn btn-success btn-sm confirm-status" data-bs-toggle="modal" data-bs-target="#statusModal" data-action="@Url.Action("ApproveListing", "Admin")" data-id="@item.ListingId" data-title="Approve company?">Approve</button>
                                    }
                                    @if (item.Status != "Rejected")
                                    {
                                        <button type="button" class="btn btn-danger btn-sm confirm-status" data-bs-toggle="modal" data-bs-target="#statusModal" data-action="@Url.Action("RejectListing", "Admin")" data-id="@item.ListingId" data-title="Reject company?">Reject</button>
                                    }
                                    <a asp-action="ListingDetails" asp-route-id="@item.ListingId" class="btn btn-outline-secondary btn-sm">Details</a>
                                    <a asp-action="EditListing" asp-route-id="@item.ListingId" class="btn btn-outline-primary btn-sm">Edit</a>
                                    <a asp-action="DeleteListing" asp-route-id="@item.ListingId" class="btn btn-outline-danger btn-sm">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6"><div class="empty-state"><i class="fa fa-building text-warning fs-4"></i><p class="mb-0 mt-2">No companies found for selected filter.</p></div></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Listings", new { status = ViewBag.Status, search = ViewBag.Search, page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Listings", new { status = ViewBag.Status, search = ViewBag.Search, page = i, pageSize = ViewBag.PageSize })">@i</a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Listings", new { status = ViewBag.Status, search = ViewBag.Search, page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="statusModalTitle">Confirm</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">Are you sure?</div>
            <div class="modal-footer">
                <form method="post" id="statusForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="statusId" />
                    <button class="btn btn-warning">Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll(".confirm-status").forEach(btn=>btn.addEventListener("click",()=>{document.getElementById("statusForm").action=btn.dataset.action;document.getElementById("statusId").value=btn.dataset.id;document.getElementById("statusModalTitle").textContent=btn.dataset.title;}));
</script>
}
