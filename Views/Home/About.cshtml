@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<section class="py-5">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">About RadioCabs</h1>
                <p class="lead mb-4 opacity-75">India's premier cab directory platform connecting trusted transport companies with millions of customers.</p>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-6">
                <div class="p-4 rounded-4 h-100">
                    <h3 class="mb-3" style="color: var(--rc-yellow);">Our Mission</h3>
                    <p class="mb-0">To provide a safe, reliable, and transparent platform for customers to find trusted cab services while helping transport companies grow their business through verified listings and premium advertising.</p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="p-4 rounded-4 h-100">
                    <h3 class="mb-3" style="color: var(--rc-yellow);">Our Vision</h3>
                    <p class="mb-0">To become India's most trusted and comprehensive transport directory, setting the standard for safety, reliability, and customer service in the cab industry.</p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="premium-card p-4 text-center">
                    <div class="display-4 fw-bold mb-2" style="color: var(--rc-yellow);">2018</div>
                    <div class="text-muted">Founded</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="premium-card p-4 text-center">
                    <div class="display-4 fw-bold mb-2" style="color: var(--rc-yellow);">250+</div>
                    <div class="text-muted">Verified Drivers</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="premium-card p-4 text-center">
                    <div class="display-4 fw-bold mb-2" style="color: var(--rc-yellow);">40+</div>
                    <div class="text-muted">Cities Covered</div>
                </div>
            </div>
        </div>
    </div>
</section>
