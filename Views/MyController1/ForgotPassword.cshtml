@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="premium-card p-4">
                    <h3 class="fw-bold mb-4 text-center">Forgot Password</h3>
                    <p class="text-muted text-center mb-4">Enter your email address and we'll send you a link to reset your password.</p>
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="email" class="form-control" placeholder="Enter your email" required>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-semibold">Send Reset Link</button>
                    </form>
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
