@section Scripts {
<script>
    function handleQuickSearch() {
        const query = document.getElementById("quickSearchInput").value.trim().toLowerCase();
        const searchType = document.getElementById("quickSearchType").value;

        if (searchType === "company") {
            window.location.href = `/MyController1/Listing?search=${encodeURIComponent(query)}`;
        } else {
            window.location.href = `/MyController1/Drivers?search=${encodeURIComponent(query)}`;
        }
    }

    function showCompanyModal(name, code, person, designation, city, mobile, tel, fax, email, address, description) {
        document.getElementById("compModalTitle").textContent = name;
        document.getElementById("compCode").textContent = code || "N/A";
        document.getElementById("compCity").textContent = city || "N/A";
        document.getElementById("compPerson").textContent = person || "N/A";
        document.getElementById("compDesg").textContent = designation || "N/A";
        document.getElementById("compMobile").textContent = mobile || "N/A";
        document.getElementById("compPhone").textContent = (tel ? "Tel: " + tel : "") + (fax ? " / Fax: " + fax : "") || "N/A";
        document.getElementById("compEmail").textContent = email || "N/A";
        document.getElementById("compAddr").textContent = address || "N/A";
        document.getElementById("compDesc").textContent = description || "No custom company description provided.";
        
        new bootstrap.Modal(document.getElementById('companyDetailModal')).show();
    }

    function showDriverModal(name, code, city, person, mobile, telephone, email, experience, address, description) {
        document.getElementById("driverModalTitle").textContent = name;
        document.getElementById("dCode").textContent = code || "N/A";
        document.getElementById("dCity").textContent = city || "N/A";
        document.getElementById("dExp").textContent = experience ? experience + " Years" : "N/A";
        document.getElementById("dMobile").textContent = mobile || "N/A";
        document.getElementById("dPhone").textContent = telephone || "N/A";
        document.getElementById("dEmail").textContent = email || "N/A";
        document.getElementById("dAddr").textContent = address || "N/A";
        document.getElementById("dDesc").textContent = description || "No profile description provided.";
        
        new bootstrap.Modal(document.getElementById('driverDetailModal')).show();
    }

    document.getElementById("contactForm")?.addEventListener("submit", function(e) {
        e.preventDefault();
        alert("Thank you for reaching out! Your inquiry has been submitted and our team will get back to you shortly.");
        this.reset();
    });
</script>
}
