@model Radiocab.Models.Payment
@{
    ViewData["Title"] = "Delete Payment";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Delete Payment</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Are you sure you want to delete this payment? This action cannot be undone.
                    </div>

                    <div class="bg-light p-4 rounded mb-4">
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Receipt Number:</div>
                            <div class="col-6 fw-semibold">@Model.ReceiptNumber</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Transaction ID:</div>
                            <div class="col-6 fw-semibold">@Model.TransactionId</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Amount:</div>
                            <div class="col-6 fw-bold text-danger">@Model.Amount.ToString("C")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Payment Method:</div>
                            <div class="col-6 fw-semibold">@Model.PaymentMethod</div>
                        </div>
                        <div class="row">
                            <div class="col-6 text-muted">Status:</div>
                            <div class="col-6 fw-semibold">@Model.Status</div>
                        </div>
                    </div>

                    <form asp-action="DeletePaymentConfirmed" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PaymentId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-2"></i>Yes, Delete
                            </button>
                            <a asp-action="AdminPayments" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
