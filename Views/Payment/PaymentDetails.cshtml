@model Radiocab.Models.Payment
@{
    ViewData["Title"] = "Payment Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-receipt me-2"></i>Payment Details</h4>
                        <a asp-action="AdminPayments" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted">Receipt Number</label>
                            <p class="fw-semibold fs-5">@Model.ReceiptNumber</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Transaction ID</label>
                            <p class="fw-semibold">@Model.TransactionId</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted">Entity Type</label>
                            <p class="fw-semibold">@Model.EntityType</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Entity ID</label>
                            <p class="fw-semibold">@Model.EntityId</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted">Amount</label>
                            <p class="fw-bold text-success fs-4">
                                @(Model.PaymentType == "Monthly" ? "$15" : "$40")
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Status</label>
                            <p>
                                @if (Model.Status == "Paid")
                                {
                                    <span class="badge bg-success fs-6">Paid</span>
                                }
                                else if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark fs-6">Pending</span>
                                }
                                else if (Model.Status == "Failed")
                                {
                                    <span class="badge bg-danger fs-6">Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-info fs-6">@Model.Status</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted">Payment Method</label>
                            <p class="fw-semibold">@Model.PaymentMethod</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Payment Type</label>
                            <p class="fw-semibold">@Model.PaymentType</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted">Payment Date</label>
                            <p class="fw-semibold">@Model.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted">Due Date</label>
                            <p class="fw-semibold">@(Model.DueDate?.ToString("dd MMM yyyy") ?? "N/A")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                            <label class="text-muted">Description</label>
                            <p class="fw-semibold">@Model.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mb-4">
                            <label class="text-muted">Notes</label>
                            <p class="fw-semibold">@Model.Notes</p>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button onclick="window.print()" class="btn btn-outline-dark">
                            <i class="fas fa-print me-2"></i>Print Receipt
                        </button>
                        <a asp-action="DeletePayment" asp-route-id="@Model.PaymentId" class="btn btn-outline-danger">
                            <i class="fas fa-trash me-2"></i>Delete Payment
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
