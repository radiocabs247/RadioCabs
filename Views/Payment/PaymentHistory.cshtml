@model List<Radiocab.Models.Payment>
@{
    ViewData["Title"] = "Payment History";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-history me-2"></i>Payment History</h4>
                    <a asp-action="UnitDashboard" asp-controller="MyController1" class="btn btn-warning btn-sm">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
                <div class="card-body p-4">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Receipt #</th>
                                        <th>Transaction ID</th>
                                        <th>Entity</th>
                                        <th>Amount</th>
                                        <th>Method</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@payment.ReceiptNumber</span></td>
                                            <td><small>@payment.TransactionId</small></td>
                                            <td>@payment.EntityType</td>
                                            <td class="fw-bold">@payment.Amount.ToString("C")</td>
                                            <td>@payment.PaymentMethod</td>
                                            <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @if (payment.Status == "Paid")
                                                {
                                                    <span class="badge bg-success">Paid</span>
                                                }
                                                else if (payment.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@payment.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Receipt" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-dark">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="display-4 text-muted mb-3">
                                <i class="fas fa-receipt"></i>
                            </div>
                            <h5 class="text-muted">No payment history found</h5>
                            <p class="text-muted">You haven't made any payments yet.</p>
                            <a asp-action="UnitDashboard" asp-controller="MyController1" class="btn btn-warning">
                                <i class="fas fa-tachometer-alt me-2"></i>Go to Dashboard
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
