@model Radiocab.Models.Payment
@{
    ViewData["Title"] = "Payment Receipt";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white py-3 text-center">
                    <h4 class="mb-0"><i class="fas fa-check-circle me-2"></i>Payment Successful</h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="display-1 text-success mb-3">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <h5 class="text-muted">Thank you for your payment!</h5>
                    </div>

                    <div class="bg-light p-4 rounded mb-4">
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Receipt Number:</div>
                            <div class="col-6 fw-semibold">@Model.ReceiptNumber</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Transaction ID:</div>
                            <div class="col-6 fw-semibold">@Model.TransactionId</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Payment Date:</div>
                            <div class="col-6 fw-semibold">@Model.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Payment Method:</div>
                            <div class="col-6 fw-semibold">@Model.PaymentMethod</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Payment Type:</div>
                            <div class="col-6 fw-semibold">@Model.PaymentType</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-muted">Entity Type:</div>
                            <div class="col-6 fw-semibold">@Model.EntityType</div>
                        </div>
                        <div class="row">
                            <div class="col-6 text-muted fw-bold">Amount Paid:</div>
                            @{
                                decimal demoAmount = 0;

                                if (Model.EntityType == "Listing")
                                {
                                    demoAmount = Model.PaymentType == "Monthly" ? 15 : 40;
                                }
                                else if (Model.EntityType == "Driver")
                                {
                                    demoAmount = Model.PaymentType == "Monthly" ? 10 : 25;
                                }
                                else if (Model.EntityType == "Advertisement")
                                {
                                    demoAmount = Model.PaymentType == "Monthly" ? 15 : 40;
                                }
                            }
                            <div class="col-6 fw-bold text-success fs-5">$@demoAmount</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                            <label class="text-muted">Notes:</label>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button onclick="window.print()" class="btn btn-outline-dark">
                            <i class="fas fa-print me-2"></i>Print Receipt
                        </button>
                        <a asp-action="PaymentHistory" class="btn btn-warning">
                            <i class="fas fa-history me-2"></i>View Payment History
                        </a>
                        <a asp-action="UnitDashboard" asp-controller="MyController1" class="btn btn-outline-secondary">
                            <i class="fas fa-tachometer-alt me-2"></i>Go to Dashboard
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light text-center text-muted py-3">
                    <small>RadioCabs - Premium Transport Platform</small>
                </div>
            </div>
        </div>
    </div>
</div>
