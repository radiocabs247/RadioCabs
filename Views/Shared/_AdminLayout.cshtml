<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - RadioCab Admin</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="~/images/FAVICON.png" type="image/x-icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="rc-body">
    <div class="d-flex">
        <aside class="admin-sidebar p-3">
            <h5 class="fw-bold mb-4 rc-brand"><span>Radio</span>Cabs <small class="text-secondary">Admin</small></h5>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item"><a class="nav-link text-white" asp-action="Index" asp-controller="Admin"><i class="fa fa-gauge me-2"></i>Dashboard</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-action="Listings" asp-controller="Admin"><i class="fa fa-building me-2"></i>Listings</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-action="Drivers" asp-controller="Admin"><i class="fa fa-id-card me-2"></i>Drivers</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-action="Advertisements" asp-controller="Admin"><i class="fa fa-bullhorn me-2"></i>Advertisements</a></li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Payment"
                           asp-action="AdminPayments">
                        <i class="fas fa-dollar-sign me-2"></i>
                        Payments
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link text-white" asp-action="Feedbacks" asp-controller="Admin"><i class="fa fa-message me-2"></i>Feedbacks</a></li>
                <li class="nav-item mt-3"><a class="nav-link text-warning" asp-action="Logout" asp-controller="MyController1"><i class="fa fa-right-from-bracket me-2"></i>Logout</a></li>
            </ul>
        </aside>

        <div class="flex-grow-1 min-vh-100">
            <nav class="navbar navbar-expand-lg rc-admin-topbar border-bottom px-3">
                <span class="navbar-brand mb-0 h5 text-light">@ViewData["Title"]</span>
            </nav>
            <main class="p-3 p-md-4">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="adminToast" class="toast align-items-center text-bg-@(TempData["Error"] != null ? "danger" : "success") border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        @(TempData["Error"] ?? TempData["Success"])
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener("load", function () {
            const t = document.getElementById("adminToast");
            if (t) new bootstrap.Toast(t, { delay: 2500 }).show();
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
