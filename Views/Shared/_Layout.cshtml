<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - RadioCabs</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="~/images/FAVICON.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="rc-body">
    <div id="pageLoader" class="page-loader">
        <div class="spinner-border text-warning" role="status"></div>
    </div>

    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark rc-navbar">
            <div class="container">
                        <a class="navbar-brand rc-brand" asp-action="Index" asp-controller="MyController1">
                            <img src="~/images/Logo-Radio-Cabs.png" alt="RadioCabs Logo" class="img-fluid" style="height:60px;" width="80px">
                            </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a asp-action="Index" asp-controller="MyController1" class="nav-link">Home</a></li>
                        <li class="nav-item"><a asp-action="Listing" asp-controller="MyController1" class="nav-link">Listing</a></li>
                        <li class="nav-item"><a asp-action="Drivers" asp-controller="MyController1" class="nav-link">Drivers</a></li>
                        <li class="nav-item"><a asp-action="Services" asp-controller="MyController1" class="nav-link">Services</a></li>
                        <li class="nav-item"><a asp-action="Advertise" asp-controller="MyController1" class="nav-link">Advertise</a></li>
                        <li class="nav-item"><a asp-action="Feedback" asp-controller="MyController1" class="nav-link">Feedback</a></li>
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            var role = Context.Session.GetString("UserRole");
                            if (role == "Admin")
                            {
                                <li class="nav-item"><a asp-action="Index" asp-controller="Admin" class="nav-link text-warning fw-bold"><i class="fas fa-cog me-1"></i>Admin Panel</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a asp-action="UnitDashboard" asp-controller="MyController1" class="nav-link text-warning fw-bold"><i class="fas fa-th-large me-1"></i>Dashboard</a></li>
                            }
                            <li class="nav-item"><a asp-action="Logout" asp-controller="MyController1" class="nav-link text-danger"><i class="fas fa-sign-out-alt"></i></a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a asp-action="Login" asp-controller="MyController1" class="nav-link"><i class="fas fa-sign-in-alt me-1"></i>Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container-fluid px-0">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="rc-footer py-5 mt-auto">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="mb-3 rc-brand"><span>Radio</span>Cabs</h5>
                    <p class="mb-0 text-secondary">Premium cab booking directory for trusted companies and drivers.</p>
                </div>
                <div class="col-md-2">
                    <h6 class="mb-3 text-white">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-action="Index" asp-controller="MyController1" class="text-secondary text-decoration-none">Home</a></li>
                        <li class="mb-2"><a asp-action="Listing" asp-controller="MyController1" class="text-secondary text-decoration-none">Listings</a></li>
                        <li class="mb-2"><a asp-action="Drivers" asp-controller="MyController1" class="text-secondary text-decoration-none">Drivers</a></li>
                        <li class="mb-2"><a asp-action="Advertise" asp-controller="MyController1" class="text-secondary text-decoration-none">Advertise</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="mb-3 text-white">Support</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-action="FAQ" asp-controller="Home" class="text-secondary text-decoration-none">FAQ</a></li>
                        <li class="mb-2"><a asp-action="Contact" asp-controller="Home" class="text-secondary text-decoration-none">Contact Us</a></li>
                        <li class="mb-2"><a asp-action="About" asp-controller="Home" class="text-secondary text-decoration-none">About Us</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="mb-3 text-white">Legal</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-action="Terms" asp-controller="Home" class="text-secondary text-decoration-none">Terms & Conditions</a></li>
                        <li class="mb-2"><a asp-action="Privacy" asp-controller="Home" class="text-secondary text-decoration-none">Privacy Policy</a></li>
                    </ul>
                    <div class="mt-3">
                        <a asp-action="Login" asp-controller="MyController1" class="btn btn-warning btn-sm fw-semibold">Admin / Unit Login</a>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary">
            <div class="text-center text-secondary">
                <small>&copy; @DateTime.Now.Year RadioCabs. All rights reserved.</small>
            </div>
        </div>
    </footer>

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="mainToast" class="toast align-items-center text-bg-@(TempData["Error"] != null ? "danger" : "success") border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        @(TempData["Error"] ?? TempData["Success"])
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener("load", function () {
            const loader = document.getElementById("pageLoader");
            if (loader) loader.classList.add("d-none");
            const t = document.getElementById("mainToast");
            if (t) new bootstrap.Toast(t, { delay: 2500 }).show();

            // GSAP Animations
            gsap.registerPlugin(ScrollTrigger);

            // Animate hero elements
            gsap.from(".hero-section h1", {
                opacity: 0,
                y: 50,
                duration: 1,
                ease: "power3.out"
            });

            gsap.from(".hero-section p", {
                opacity: 0,
                y: 30,
                duration: 1,
                delay: 0.3,
                ease: "power3.out"
            });

            gsap.from(".hero-section .btn", {
                opacity: 0,
                y: 20,
                duration: 0.8,
                delay: 0.5,
                stagger: 0.2,
                ease: "power3.out"
            });

            // Animate cards on scroll
            gsap.utils.toArray('.premium-card').forEach((card, i) => {
                gsap.from(card, {
                    scrollTrigger: {
                        trigger: card,
                        start: "top 85%",
                        toggleActions: "play none none reverse"
                    },
                    opacity: 0,
                    y: 40,
                    duration: 0.8,
                    delay: i * 0.1,
                    ease: "power3.out"
                });
            });

            // Animate stats
            gsap.utils.toArray('.stat-card').forEach((stat, i) => {
                gsap.from(stat, {
                    scrollTrigger: {
                        trigger: stat,
                        start: "top 85%",
                        toggleActions: "play none none reverse"
                    },
                    opacity: 0,
                    scale: 0.8,
                    duration: 0.6,
                    delay: i * 0.15,
                    ease: "back.out(1.7)"
                });
            });

            // Navbar animation
            gsap.from(".navbar-brand", {
                opacity: 0,
                x: -30,
                duration: 0.8,
                ease: "power3.out"
            });

            gsap.from(".nav-item", {
                opacity: 0,
                y: -20,
                duration: 0.6,
                stagger: 0.1,
                ease: "power3.out"
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
